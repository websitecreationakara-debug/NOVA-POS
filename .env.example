# Supabase project: nova-pos
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Storefront product APIs
SORA_SAKE_PRODUCTS_API_URL=
SORA_SAKE_PRODUCTS_API_KEY=
SORA_SAKE_CATEGORIES_API_URL=

BOSBA_DRINK_SNACK_PRODUCTS_API_URL=
BOSBA_DRINK_SNACK_PRODUCTS_API_TOKEN=
BOSBA_DRINK_SNACK_CATEGORIES_API_URL=

BOSBA_PREMIUM_FOODS_PRODUCTS_API_URL=
BOSBA_PREMIUM_FOODS_PRODUCTS_API_KEY=
BOSBA_PREMIUM_FOODS_ADDONS_API_URL=
# Categories endpoint on the same storefront -- reuses the key above.
BOSBA_PREMIUM_FOODS_CATEGORIES_API_URL=

# Vercel authentication token - server/local environment only
VERCEL_OIDC_TOKEN=

# Automatic order backup to Google Drive (see scripts/google-drive-backup.gs)
# Bearer secret the scheduler (GitHub Action) sends to /api/backup-to-drive.
BACKUP_CRON_SECRET=
# The Apps Script web app URL and the BACKUP_SECRET set inside that script.
GOOGLE_DRIVE_BACKUP_URL=
GOOGLE_DRIVE_BACKUP_SECRET=
# Leave unset to leave customer names/phones/addresses out of the backup zip.
BACKUP_INCLUDE_CUSTOMER=

# Meta (Facebook) Conversions API -- CRM historical Purchase backfill
# (see scripts/meta-crm-backfill.mjs) and real-time Purchase sync on every
# sale (see src/lib/metaConversions.ts, wired into sales/actions.ts and
# api/order-sync). Generate each token in that dataset's Events Manager >
# Settings > Conversions API > Set up direct integration > Generate Access Token.
META_DATASET_ID=557782553161482
# Covers the BOSBA Premium Foods + SORA SAKE datasets (557782553161482, 609436530954785).
META_ACCESS_TOKEN=
# Covers the BOSBA Drink&Snack dataset (965650992440513) -- generate separately;
# until this is set, real-time Purchase sync for that brand is skipped (logged, not fatal).
META_ACCESS_TOKEN_DRINK_SNACK=
META_API_VERSION=v21.0
META_ACTION_SOURCE=physical_store
